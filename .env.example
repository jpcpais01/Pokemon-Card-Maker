# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Only needed for 1v1 Battle mode. Create a free Redis database at
# https://upstash.com (or use Vercel's Upstash marketplace integration) and
# copy its REST URL/token here. Without these set, battle mode falls back to
# an in-memory store that only works for local dev with a single server
# instance - it will NOT work correctly once deployed to Vercel.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
