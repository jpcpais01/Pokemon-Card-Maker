# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Only needed for 1v1 Battle mode. Create a free Redis database at
# https://upstash.com and copy its REST URL/token here. Without these set,
# battle mode falls back to an in-memory store that only works for local dev
# with a single server instance - it will NOT work correctly once deployed
# to Vercel.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# If you instead connect a database via Vercel's Storage tab (the Upstash
# marketplace integration), it names these vars KV_REST_API_URL /
# KV_REST_API_TOKEN - the app reads either naming automatically, so you
# don't need to add both.
